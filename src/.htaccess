# Vacations4Less static site
Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 {{root}}404.html

# STAGING ONLY: keep search engines out of /staging. Removed automatically by STAGING=0 builds.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# END STAGING ONLY

# Old WordPress URLs -> new pages (active once the site moves to the domain root).
# /about/, /services/ and /contact/ keep the same address as on WordPress, so they need no redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^nakalele-blowhole-maui/?$ {{root}}blog/nakalele-blowhole-maui/ [R=301,L]
  RewriteRule ^lahaina-wildfire-logistical-support/?$ {{root}}blog/ [R=301,L]
  RewriteRule ^blog/lahaina-wildfire-logistical-support/?$ {{root}}blog/ [R=301,L]
  RewriteRule ^travel-tips-blog/?$ {{root}}blog/ [R=301,L]
  # Earlier staging links that ended in .html
  RewriteRule ^(services|about|contact|thank-you)\.html$ {{root}}$1/ [R=301,L]
</IfModule>

<FilesMatch "\.(py|md|yml|yaml|json|lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
